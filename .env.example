# Supabase project URL and PUBLISHABLE key (not a secret/service_role key).
PONDTWIN_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PONDTWIN_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
PONDTWIN_CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","https://pondtwin.onrender.com"]
PONDTWIN_TELEMETRY_INTERVAL_SECONDS=60
PONDTWIN_TELEMETRY_STALE_SECONDS=600
PONDTWIN_THINGSPEAK_HISTORY_RESULTS=2000
